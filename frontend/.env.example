# Copiez ce fichier en ".env" (developpement) ou ".env.production" (build)
# et adaptez les valeurs a votre environnement.
# Ces valeurs sont publiques (visibles dans le bundle JS) : ne jamais y
# mettre de secret (client_secret, cle d'API, mot de passe...).

# Base des appels vers le backend Express (reverse-proxy en prod)
VITE_API_BASE_URL=/MedSearch/api

# Parametres du SSO WordPress (plugin miniOrange) - identifiant public uniquement
VITE_OAUTH_CLIENT_ID=changez-moi
VITE_OAUTH_AUTHORIZATION_ENDPOINT=https://cv-mb.hd.free.fr/wp-json/moserver/authorize
VITE_OAUTH_LOGOUT_ENDPOINT=https://cv-mb.hd.free.fr/logout/
VITE_OAUTH_REDIRECT_URI=https://cv-mb.hd.free.fr/MedSearch/auth/callback

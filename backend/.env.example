# Copiez ce fichier en ".env" et renseignez vos propres valeurs.
# Ne jamais committer le fichier .env reel dans Git.

# Port d'ecoute du serveur Express
PORT=3000

# Origine autorisee pour le CORS (URL du frontend en production)
CORS_ORIGIN=url_CORS_ORIGIN

# Cle d'API de la plateforme esante.gouv.fr (Gateway API FHIR)
# https://esante.gouv.fr/ - a obtenir depuis votre compte developpeur
ESANTE_API_KEY=changez-moi

# Parametres OAuth2 du serveur SSO WordPress (plugin miniOrange)
# Le "client secret" ne doit JAMAIS se trouver dans le code frontend :
# c'est ce backend qui l'utilise pour echanger le "code" contre un token.
WP_TOKEN_ENDPOINT=url_WP_TOKEN_ENDPOINT/token
WP_CLIENT_ID=changez-moi
WP_CLIENT_SECRET=changez-moi
WP_REDIRECT_URI=url_WP/auth/callback

# Endpoint "userinfo" du SSO : sert a verifier chaque access_token recu
# sur les routes /medecins et /fhir/practitioners.
WP_USERINFO_ENDPOINT=url_WP_USERINFO_ENDPOINT/resource

# Interface d'ecoute. Laisser 127.0.0.1 : seul Apache (meme machine) doit
# atteindre le backend. Ne mettre 0.0.0.0 que si vous savez pourquoi.
HOST=127.0.0.1

# Copiez ce fichier en ".env" et renseignez vos propres valeurs.
# Ne jamais committer le fichier .env reel dans Git.

# Port d'ecoute du serveur Express
PORT=3000

# Origine autorisee pour le CORS (URL du frontend en production)
CORS_ORIGIN=https://cv-mb.hd.free.fr

# Cle d'API de la plateforme esante.gouv.fr (Gateway API FHIR)
# https://esante.gouv.fr/ - a obtenir depuis votre compte developpeur
ESANTE_API_KEY=changez-moi

# Parametres OAuth2 du serveur SSO WordPress (plugin miniOrange)
# Le "client secret" ne doit JAMAIS se trouver dans le code frontend :
# c'est ce backend qui l'utilise pour echanger le "code" contre un token.
WP_TOKEN_ENDPOINT=https://cv-mb.hd.free.fr/wp-json/moserver/token
WP_CLIENT_ID=changez-moi
WP_CLIENT_SECRET=changez-moi
WP_REDIRECT_URI=https://cv-mb.hd.free.fr/MedSearch/auth/callback

# Endpoint "userinfo" du SSO : sert a verifier chaque access_token recu
# sur les routes /medecins et /fhir/practitioners.
WP_USERINFO_ENDPOINT=https://cv-mb.hd.free.fr/wp-json/moserver/resource

# Interface d'ecoute. Laisser 127.0.0.1 : seul Apache (meme machine) doit
# atteindre le backend. Ne mettre 0.0.0.0 que si vous savez pourquoi.
HOST=127.0.0.1

# --- Session (cookie HttpOnly) ---
# Le token SSO reste cote serveur ; le navigateur ne recoit qu'un identifiant
# de session opaque dans un cookie HttpOnly, Secure, SameSite=Strict.
# COOKIE_SECURE : laisser a true en production (HTTPS). "false" uniquement pour
# un test local en http.
COOKIE_SECURE=true
# Chemin PUBLIC de l'API vu par le navigateur (derriere Apache) : le cookie n'est
# envoye qu'a ce chemin, donc ni a WordPress ni aux autres applications.
COOKIE_PATH=/MedSearch/api
# Duree maximale d'une session (heures) et delai d'inactivite (minutes).
SESSION_MAX_AGE_HOURS=8
SESSION_IDLE_MINUTES=60
# Frequence de revalidation du token aupres du SSO (secondes) : une revocation
# cote WordPress coupe l'acces au plus tard apres ce delai.
SESSION_REVALIDATE_SECONDS=60
